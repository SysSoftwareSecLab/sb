    "scene": "Two distinct parts cross a capacity-one supported buffer from LEFT producer to RIGHT consumer.",
    "deadline_s": 50,
    "goal": [
      "part_0 at target_0; part_1 at target_1; empty arms at homes; buffer empty; lock free; events inactive",
